{
  "name": "obsidian-daily-task-drain",
  "version": "0.1.0",
  "description": "Obsidian plugin that drains completed tasks from the whole vault into today's daily note.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "steimerbyte",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "jest"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "daily-notes"
  ],
  "dependencies": {
    "moment": "^2.30.1",
    "obsidian-daily-notes-interface": "^0.9.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "jest": "^29.7.0",
    "obsidian": "latest",
    "ts-jest": "^29.1.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "target": "ES2018",
            "module": "CommonJS",
            "moduleResolution": "node",
            "esModuleInterop": true,
            "isolatedModules": false,
            "noEmit": false
          }
        }
      ]
    }
  }
}